<?xml version="1.0" encoding="utf-8"?>
<!--
  HexEngine SDK description - INSTALLED flavour ({app}\SDK\HexEngine.props).

  Game projects generated by the editor import this file for every include,
  library and runtime path (see the repository-root HexEngine.props for the
  development-tree flavour and the full explanation).

  An installed SDK ships only the RELEASE engine. HexEngine.Core exports C++
  classes that pass STL types (std::string, std::vector, std::filesystem::path,
  std::function) across the DLL boundary, so a game must use the SAME runtime
  library and iterator-debug level as the engine it loads into: /MD with
  _DEBUG undefined. The game's Debug configuration is therefore a debuggable
  build with the Release ABI - optimisation off and full PDBs, but no debug
  CRT. Mixing /MDd game code with the /MD engine would corrupt memory.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <HexEngineSdkKind>Installed</HexEngineSdkKind>
    <HexEngineRoot>$(MSBuildThisFileDirectory)</HexEngineRoot>

    <HexEngineIncludeDirs>$(HexEngineRoot)Include\;$(HexEngineRoot)Include\DirectXTK\</HexEngineIncludeDirs>
    <HexEngineLibDir>$(HexEngineRoot)Lib\x64\Release\</HexEngineLibDir>
    <!-- The editor, runtime DLLs, Plugins\, Bin\ and the tools live one level up. -->
    <HexEngineRuntimeDir>$([System.IO.Path]::GetFullPath('$(HexEngineRoot)..\'))</HexEngineRuntimeDir>

    <HexEngineDebugUseDebugLibraries>false</HexEngineDebugUseDebugLibraries>
    <HexEngineDebugRuntimeLibrary>MultiThreadedDLL</HexEngineDebugRuntimeLibrary>
    <HexEngineDebugDefines>NDEBUG</HexEngineDebugDefines>
  </PropertyGroup>
</Project>
