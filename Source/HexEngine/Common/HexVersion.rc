// Shared VERSIONINFO resource for every HexEngine EXE and DLL.
//
// Injected into each Application / DynamicLibrary project by
// Source/HexEngine/Directory.Build.targets (no per-project .rc edits), so the
// version shown in Explorer -> Properties -> Details comes from the same
// /p:HexVersion the release tag sets. See HexEngine.Core/HexVersion.hpp.
#include <winres.h>
#include "../HexEngine.Core/HexVersion.hpp"

#if HEX_VERSION_IS_DEV
#define HEX_RC_FILEFLAGS VS_FF_PRERELEASE
#define HEX_RC_VERSION_TEXT HEX_VERSION_STRING "-dev"
#else
#define HEX_RC_FILEFLAGS 0x0L
#define HEX_RC_VERSION_TEXT HEX_VERSION_STRING
#endif

#ifdef HEX_RC_IS_DLL
#define HEX_RC_FILETYPE VFT_DLL
#else
#define HEX_RC_FILETYPE VFT_APP

// Application icon (lowest icon ID = what Explorer, shortcuts and the taskbar
// show). Same artwork the editor loads at runtime from
// Data/Textures/UI/hex_icon.ico.
1 ICON "HexEngine.ico"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION HEX_VERSION_MAJOR,HEX_VERSION_MINOR,HEX_VERSION_PATCH,0
 PRODUCTVERSION HEX_VERSION_MAJOR,HEX_VERSION_MINOR,HEX_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS HEX_RC_FILEFLAGS
 FILEOS VOS_NT_WINDOWS32
 FILETYPE HEX_RC_FILETYPE
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "HexPerson"
            VALUE "FileDescription", "HexEngine"
            VALUE "FileVersion", HEX_RC_VERSION_TEXT
            VALUE "LegalCopyright", "Copyright (c) HexPerson"
            VALUE "ProductName", "HexEngine"
            VALUE "ProductVersion", HEX_RC_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
