<?xml version="1.0" encoding="utf-8"?>
<!--
  HexEngine SDK description - DEVELOPMENT TREE flavour.

  Game projects generated by the editor import <SDK>\HexEngine.props (see
  Content/EngineData/Templates/ProjectTemplate.txt) and take every include
  path, library path and runtime-binary path from it, so the templates carry
  no knowledge of where the engine lives.

  This copy sits at the repository root and describes a source checkout:
  headers staged under Include\, per-configuration libraries under
  Libs\x64\<Config>\ and runtime binaries under Bin\x64\<Config>\. A Debug game
  links the Debug engine (both /MDd), exactly as generated projects always did.

  An installed build ships a different HexEngine.props under {app}\SDK\
  (installer\sdk\HexEngine.props) that points at Release-only libraries.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <HexEngineSdkKind>Development</HexEngineSdkKind>
    <HexEngineRoot>$(MSBuildThisFileDirectory)</HexEngineRoot>

    <_HexEngineConfig>$(Configuration)</_HexEngineConfig>
    <_HexEngineConfig Condition="'$(_HexEngineConfig)' != 'Release'">Debug</_HexEngineConfig>

    <HexEngineIncludeDirs>$(HexEngineRoot)Include\;$(HexEngineRoot)ThirdParty\DirectXTK\Inc\</HexEngineIncludeDirs>
    <HexEngineLibDir>$(HexEngineRoot)Libs\x64\$(_HexEngineConfig)\</HexEngineLibDir>
    <HexEngineRuntimeDir>$(HexEngineRoot)Bin\x64\$(_HexEngineConfig)\</HexEngineRuntimeDir>

    <!-- The game's Debug configuration matches the Debug engine it links. -->
    <HexEngineDebugUseDebugLibraries>true</HexEngineDebugUseDebugLibraries>
    <HexEngineDebugRuntimeLibrary>MultiThreadedDebugDLL</HexEngineDebugRuntimeLibrary>
    <HexEngineDebugDefines>_DEBUG</HexEngineDebugDefines>
  </PropertyGroup>
</Project>
